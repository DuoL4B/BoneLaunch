{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoneLaunch",
  "version": "1.1.0",
  "identifier": "com.bonelaunch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BoneLaunch",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#07090d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.thunderstore.io; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "DuoL4B",
    "shortDescription": "A mod launcher for BONELAB",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
